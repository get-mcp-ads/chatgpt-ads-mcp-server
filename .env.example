# chatgpt-ads-mcp-server configuration. See the README.

# Advertiser API key, created on the Settings page of Ads Manager (ads.openai.com).
# Each key is scoped to one ad account. Keep it secret and never commit it.
OPENAI_ADS_API_KEY=

# The adacct_ ID of the ad account the key belongs to. The server refuses every
# other account and checks on the first request that the key matches it.
OPENAI_ADS_ACCOUNT_ID=

# Write tools are off by default. Only the exact value true exposes them.
# Every write previews first and applies only on a confirmed second call.
OPENAI_ADS_ENABLE_WRITES=false

# Activation can start delivery and spend budget. Off by default.
# Requires OPENAI_ADS_ENABLE_WRITES=true.
OPENAI_ADS_ENABLE_ACTIVATION=false
